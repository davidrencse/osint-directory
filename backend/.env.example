# Copy to backend/.env and fill in whatever you have. Every key is optional:
# sources without a key are skipped, and the dashboard shows which ones need one.

# --- Recon / threat intel -------------------------------------------------
SHODAN_API_KEY=
# Censys: a Platform personal access token, or the legacy Search API id + secret
CENSYS_API_TOKEN=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# Works without a key (rate-limited); a key raises the limit
GREYNOISE_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
SECURITYTRAILS_API_KEY=
IPINFO_TOKEN=

# --- Live map -------------------------------------------------------------
# Free NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Free AIS websocket key: https://aisstream.io/apikeys
AISSTREAM_API_KEY=

# --- Behaviour ------------------------------------------------------------
# PIPELINE_TIMEOUT_S=20
# RECON_CACHE_TTL_S=3600
# MAX_UPLOAD_MB=50
